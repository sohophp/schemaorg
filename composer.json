{
  "name": "sohophp/schema-org",
  "description": "schema.org php library",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "schema.org",
    "structural data"
  ],
  "authors": [
    {
      "name": "sohophp",
      "email": "sohophp@gmail.com"
    }
  ],
  "homepage": "https://www.sohophp.app",
  "scripts": {
    "build": "@php bin/schema generator",
    "test": "@php vendor/bin/phpunit tests",
    "lint": "@php bin/lint",
    "analyse": "@php -d memory_limit=512M vendor/bin/phpstan analyse --configuration=phpstan.neon",
    "format:check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php"
  },
  "require": {
    "php": "^8.1.0",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "symfony/console": "^6.0",
    "phpunit/phpunit": "^10.0",
    "twig/twig": "^3.3",
    "doctrine/inflector": "*",
    "friendsofphp/php-cs-fixer": "^3.71",
    "monolog/monolog": "*",
    "phpstan/phpstan": "^2.0@stable"
  },
  "autoload": {
    "psr-4": {
      "Sohophp\\SchemaOrg\\": "src\\"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sohophp\\SchemaOrg\\Tests\\": "tests\\",
      "Sohophp\\SchemaOrg\\Examples\\": "examples\\",
      "Thing\\": "src\\Thing\\"
    }
  },
  "bin": [
    "bin/schema"
  ]
}