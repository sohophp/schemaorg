  */
  public function set{{ property.name|ucfirst }}({{ property.range_default?property.range_default~' $value':'$value' }})
  {
  $this->setProperty('{{ property.name }}', $value);
  return $this;
  }

  /**
  * @param {{ property.value_range }} $value
  * @return $this
  */
  public function add{{ property.name|ucfirst }}($value)
  {
  $current = $this->getProperty('{{ property.name }}');
  if ($current === null) {
  $current = [];
  } elseif (!is_array($current)) {
  $current = [$current];
  }
  $current[] = $value;
  $this->setProperty('{{ property.name }}', $current);
  return $this;
  }

  /**
